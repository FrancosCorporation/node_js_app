# Execute `make init` para criar um .env local com credenciais aleatórias.
DB_USER=__GENERATE__
DB_PASS=__GENERATE__
DB_HOST=127.0.0.1
DB_PORT=27018
DB_NAME=node_js_app
HOST=127.0.0.1
SERVER_PORT=3000
JWT_SECRET=__GENERATE__

# Opcional: use MONGO_URI para apontar a API a um MongoDB externo.
# MONGO_URI=mongodb://usuario:senha@host:27017/node_js_app?authSource=admin
